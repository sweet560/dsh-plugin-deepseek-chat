{
  "name": "dsh-plugin-deepseek-chat",
  "version": "1.0.0",
  "description": "DeepSeek Chat (chat.deepseek.com) as a DSH sidebar panel: full main-area chat, last-conversation memory, and crash containment.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/check-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "chat",
    "webview"
  ],
  "author": "sweet560",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet560/dsh-plugin-deepseek-chat.git"
  },
  "bugs": {
    "url": "https://github.com/sweet560/dsh-plugin-deepseek-chat/issues"
  },
  "homepage": "https://github.com/sweet560/dsh-plugin-deepseek-chat#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
