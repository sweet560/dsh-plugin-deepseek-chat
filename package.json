{
  "name": "@tianyulinfeng1/dsh-plugin-deepseek-chat",
  "version": "1.4.6",
  "description": "A DSH plugin that embeds a configurable web chat URL with one-click DeepSeek / Doubao platform presets and two-way bridges desktop conversations with the web chat: three chat entries, an optional auto-loop (web reply → desktop draft only), and a full auto-pilot channel that extracts a delimited review block, auto-submits the next turn via official conversation.send and pauses on a native Modal decision card you control. Status bar stays fixed; bind for trigger mode, start auto-pilot for full-auto, stop to fully halt, and switch back to semi-auto in one click. Full auto-pilot flow passed initial real-machine verification and is being refined.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "docs/login-persistence.md",
    "docs/RELEASE_NOTES_v1.1.1.md",
    "docs/RELEASE_NOTES_v1.1.2.md",
    "docs/RELEASE_NOTES_v1.1.5.md",
    "docs/RELEASE_NOTES_v1.1.7.md",
    "docs/RELEASE_NOTES_v1.1.8.md",
    "docs/RELEASE_NOTES_v1.1.9.md",
    "docs/RELEASE_NOTES_v1.1.10.md",
    "docs/RELEASE_NOTES_v1.4.0.md",
    "docs/RELEASE_NOTES_v1.4.1.md",
    "docs/RELEASE_NOTES_v1.4.2.md",
    "docs/RELEASE_NOTES_v1.4.3.md",
    "docs/RELEASE_NOTES_v1.4.4.md",
    "docs/RELEASE_NOTES_v1.4.5.md",
    "docs/RELEASE_NOTES_v1.4.6.md",
    "docs/全自动流程使用介绍.md",
    "docs/screenshot.png",
    "docs/screenshot-chat.png",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/check-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "chat",
    "webview"
  ],
  "author": "sweet560",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet560/dsh-plugin-deepseek-chat.git"
  },
  "bugs": {
    "url": "https://github.com/sweet560/dsh-plugin-deepseek-chat/issues"
  },
  "homepage": "https://github.com/sweet560/dsh-plugin-deepseek-chat#readme",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
