{
  "name": "@tianyulinfeng1/dsh-plugin-deepseek-chat",
  "version": "1.3.0",
  "description": "A two-way bridge between DeepSeek desktop conversations and the web chat for DSH: three chat entries (sidebar / header tab / right-sidebar card) plus an optional conditional auto-loop that transfers a finished desktop answer to chat.deepseek.com, grabs the web reply and writes it only into the desktop draft (never auto-executed), with cross-session isolation, manual session bind, a status-bar settings gear, session titles, three safety valves, a settings page with check-for-updates / one-click update, stable login and crash containment.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "docs/login-persistence.md",
    "docs/RELEASE_NOTES_v1.1.1.md",
    "docs/RELEASE_NOTES_v1.1.2.md",
    "docs/RELEASE_NOTES_v1.1.5.md",
    "docs/RELEASE_NOTES_v1.1.7.md",
    "docs/RELEASE_NOTES_v1.1.8.md",
    "docs/RELEASE_NOTES_v1.1.9.md",
    "docs/RELEASE_NOTES_v1.1.10.md",
    "docs/screenshot.png",
    "docs/screenshot-chat.png",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/check-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "chat",
    "webview"
  ],
  "author": "sweet560",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet560/dsh-plugin-deepseek-chat.git"
  },
  "bugs": {
    "url": "https://github.com/sweet560/dsh-plugin-deepseek-chat/issues"
  },
  "homepage": "https://github.com/sweet560/dsh-plugin-deepseek-chat#readme",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
